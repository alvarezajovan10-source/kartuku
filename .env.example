DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Saat pakai tunnel untuk uji webhook, tambahkan host tunnel-nya:
# ALLOWED_HOSTS=localhost,127.0.0.1,abc-123.trycloudflare.com
# CSRF_TRUSTED_ORIGINS=https://abc-123.trycloudflare.com

# Dev: kosongkan untuk pakai SQLite. Produksi: postgres://user:pass@host:5432/db
# DATABASE_URL=postgres://...

# Midtrans (ambil dari dashboard sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=False
MIDTRANS_MERCHANT_ID=

# Cloudflare R2 — biarkan USE_R2=False untuk simpan foto di folder lokal saat dev
USE_R2=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
