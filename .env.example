# Salin jadi `.env`, lalu isi. JANGAN commit file .env yang sudah terisi.
#
# ── Wajib di produksi ────────────────────────────────────────────────────────
# Buat kunci BARU untuk produksi — jangan pakai kunci dev:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=ganti-dengan-string-acak-panjang

# WAJIB False di produksi. Kalau True, dashboard /kartu-saya/ dan tombol
# "Aktifkan tanpa bayar" terbuka untuk siapa pun yang tahu alamat situs.
DJANGO_DEBUG=True

# Domain yang boleh melayani situs ini. Pisahkan koma, tanpa https://
ALLOWED_HOSTS=localhost,127.0.0.1
# Saat pakai tunnel atau hosting, tambahkan hostnya:
# ALLOWED_HOSTS=namamu.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://namamu.pythonanywhere.com

# Dev: kosongkan untuk pakai SQLite. Produksi: postgres://user:pass@host:5432/db
# DATABASE_URL=postgres://...

# YouTube Data API v3 — cek apakah lagu boleh diputar di luar YouTube.
# Kosong = pemeriksaan dilewati (kartu tetap bisa dibuat).
YOUTUBE_API_KEY=

# Midtrans — biarkan kosong selama pembayaran ditangani di luar situs
# (mis. Lynk.id). Selama kosong, halaman bayar hanya menampilkan kolom kode
# akses, bukan QRIS.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=False
MIDTRANS_MERCHANT_ID=

# Cloudflare R2 — biarkan USE_R2=False untuk simpan foto di folder lokal
USE_R2=False
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Lynk.id — pembayaran ditangani di luar situs (link di bio TikTok).
# Isi URL webhook di Lynk: Settings > Integrations > Webhook
#   https://<situsmu>/api/webhooks/lynk/
# Merchant Key BARU MUNCUL setelah URL webhook disimpan. Kosong = webhook
# ditolak, jadi tidak ada kartu yang bisa diaktifkan lewat jalur ini.
LYNK_MERCHANT_KEY=
# Harga minimal yang dianggap sah untuk 1 kartu. Turunkan sementara kalau
# sedang menguji dengan produk murah; kembalikan ke 15000 sebelum jualan.
LYNK_MIN_AMOUNT=15000
